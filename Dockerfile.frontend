# Frontend Dockerfile
FROM node:18-alpine AS builder

WORKDIR /app

# Evita postinstall do Playwright no build do front (não é necessário na imagem nginx).
ENV VERCEL=1

# Variáveis de build — precisam ser declaradas como ARG para o Vite as enxergar durante npm run build.
ARG VITE_API_URL=https://api.douradosap.com.br
ARG VITE_APP_URL=https://www.douradosap.com.br
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_MERCADOPAGO_PUBLIC_KEY
ARG VITE_MINIO_PUBLIC_URL

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_APP_URL=$VITE_APP_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_MERCADOPAGO_PUBLIC_KEY=$VITE_MERCADOPAGO_PUBLIC_KEY
ENV VITE_MINIO_PUBLIC_URL=$VITE_MINIO_PUBLIC_URL

# Copiar package files
COPY package*.json ./

# Instalar todas as dependências (dev incluído: TypeScript, etc.) — necessário para `vite build`.
RUN npm ci

# Copiar código fonte
COPY . .

# Build do frontend
RUN npm run build

# Imagem de produção
FROM nginx:alpine

# Copiar build para nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Copiar configuração nginx
COPY nginx.conf /etc/nginx/nginx.conf

# Expor porta 80
EXPOSE 80

# Iniciar nginx
CMD ["nginx", "-g", "daemon off;"]
