# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WhatsApp Business — Cloud API (Meta): a integrar; o backend atual expõe stubs (503) em /api/whatsapp e /webhook.
# Exemplos de variáveis para quando implementar (nomes típicos; ajustar ao código):
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# META_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WEBHOOK_URL=

# Frontend (Vite/React — não Next.js): URL pública da API FastAPI (VITE_* é embutido no npm run build).
# Produção: obrigatoriamente https://api.douradosap.com.br (HTTPS — evita Mixed Content). O Vercel aplica isso em vercel.json → build.env.VITE_API_URL.
# Desenvolvimento local:
VITE_API_URL="http://localhost:5000"

# --- Backend FastAPI (Python, easypanel/docker) — mesmo .env ou serviço separado ---
# DATABASE_URL="postgresql://..."
# Express (server.ts, rotas /api/store/*): use a mesma DATABASE_URL + SECRET_KEY (HS256, igual ao FastAPI) para admin da loja.
# FRONTEND_URL="https://www.douradosap.com.br"   # Origem principal do CRM (CORS)
# Lista explícita de Origins (opcional): CORS_ORIGINS="https://www.douradosap.com.br,https://douradosap.com.br"
# Se ainda faltar preflight para subdomínios: CORS_ORIGIN_REGEX="^https://([a-z0-9-]+\\.)*douradosap\\.com\\.br$"

# --- Cursor MCP (PostgreSQL / VPS) — opcional ---
# Expõe ao agente as ferramentas db_query, db_mutation, vps_*, etc. (ver mcp-servers/crm-mcp.mjs).
# 1) Copie .cursor/mcp.json.example para .cursor/mcp.json (o mcp.json real está no .gitignore).
# 2) Preencha env.DATABASE_URL com a MESMA connection string do backend (VPS).
# 3) Uma vez: cd mcp-servers && npm install
# 4) Reinicie o Cursor (MCP só carrega ao arrancar). Em Settings → MCP confirme "crm-loja" ligado.
# SSH/MinIO/Easypanel no MCP: opcional — mesmas variáveis que crm-mcp.mjs espera (SSH_HOST, MINIO_*, EASYPANEL_*).
# Aplicar um .sql na VPS sem MCP: preencha DATABASE_URL em .cursor/mcp.json (ou exporte no terminal) e execute:
#   cd mcp-servers && node apply-sql-file.mjs ../supabase/migrations/NOME.sql

# URL pública do CRM (login e rotas internas). Usado quando o visitante está em www.autopecasdourados.com.br
# e clica em "Área interna" ou numa rota só do ERP — redireciona para este domínio.
# VITE_CRM_PUBLIC_URL="https://www.douradosap.com.br"

# URL canônica da loja (/loja, /p/*, checkout). No domínio do CRM, essas rotas redirecionam para cá.
# Padrão no código: https://autopecasdourados.com.br (ajuste se usar só www).
# VITE_STORE_PUBLIC_URL="https://www.autopecasdourados.com.br"

# Landing pública (/site): WhatsApp flutuante — apenas dígitos, com DDI (ex.: 5567999100220)
VITE_WHATSAPP_CONTACT="5567999100220"

# Mapa "Onde estamos" (opcional): embed do Google Maps — Partilhar → Incorporar mapa → copiar URL do src do iframe
# VITE_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps/embed?pb=..."
# Link direto da ficha no Google (opcional)
# VITE_GOOGLE_MAPS_PLACE_URL="https://www.google.com/maps/place/..."

# Chave de navegador (Maps JavaScript API + Geocoding API + Roads API) usada pelo Rastreamento
# Ao Vivo, Histórico Logístico e Rotas de Boletos (src/components/logistica/MapaRastreamento.tsx,
# src/pages/logistica/LogisticaHistorico.tsx, src/pages/LogisticaBoletos.tsx). Restrinja por
# referrer HTTP no Google Cloud Console ao domínio de produção.
# VITE_GOOGLE_MAPS_API_KEY="sua_chave_aqui"

# Microserviço api-ia-fundo (BiRefNet, pasta api-ia-fundo/). O CRM chama em POST /api/admin/processar-fundo
# (FastAPI: app/api/admin_fundo.py; legado Node: fundoRemocaoRoutes.ts). Mesmas variáveis nos dois.
# A imagem SEM fundo é gravada onde PRODUCT_IMAGE_STORAGE apontar (MinIO recomendado abaixo).
# Em produção (Easypanel/Docker), prefira a URL INTERNA do serviço para evitar 502/HTML "Not Found"
# do proxy público apontando para o site errado. Ex.: http://api-ia-fundo:5000 (nome exato do serviço no painel)
# Evite hostnames inventados (ex.: crm-loja_api-ia-fundo) se não forem o DNS real da rede Docker — use o nome
# do serviço que o Easypanel mostra ou deixe o backend tentar api-ia-fundo:5000 por fallback.
IA_FUNDO_BASE_URL="http://api-ia-fundo:5000"
# Opcional: URL completa do endpoint (sobrescreve IA_FUNDO_BASE_URL + /remover-fundo)
# IA_FUNDO_REMOVER_URL="http://api-ia-fundo:5000/remover-fundo"
# Teste no navegador ou curl: GET {base}/health  → {"ok":true,"service":"api-ia-fundo"}

# ── Imagens de produto + saída do processar-fundo: MinIO (recomendado) ou Supabase Storage ──
# Com MinIO: fotos processadas (sem-fundo-*.jpg) vão para o bucket abaixo; imagem_url no Postgres aponta para MINIO_PUBLIC_URL/...
PRODUCT_IMAGE_STORAGE=minio
MINIO_ENDPOINT="http://minio:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="produtos"
# URL pública já com o bucket no path (como o browser abre a imagem), sem barra no fim
MINIO_PUBLIC_URL="https://midias.seudominio.com.br/produtos"

# Frontend (build): mesma base pública que MINIO_PUBLIC_URL — canonicalProdutosImageUrl() e parsing de URLs MinIO.
# O painel Produtos envia sempre para POST /api/admin/upload-produto-imagem (servidor grava em MinIO se PRODUCT_IMAGE_STORAGE=minio).
# Várias bases (vírgula): VITE_MINIO_PUBLIC_URL="https://a.com/produtos,https://b.com/produtos"
# VITE_MINIO_PUBLIC_URL="https://midias.seudominio.com.br/produtos"

# Legado — só se NÃO usar PRODUCT_IMAGE_STORAGE=minio (uploads via supabase.storage.from('produtos')):
# PRODUCT_IMAGE_STORAGE=supabase
# SUPABASE_SERVICE_ROLE_KEY="..."
#
# Migração de ficheiros Supabase → MinIO (script em mcp-servers/migrate_supabase_to_minio.mjs): depois atualizar
# imagem_url / imagem_urls na BD para o novo prefixo, ou voltar a gerar URLs coerentes com MINIO_PUBLIC_URL.

# Mercado Pago — pagamento online da loja (PIX + Cartão). Use as credenciais
# de TESTE (sandbox) do painel https://www.mercadopago.com.br/developers/panel
# até a conta de produção da loja estar pronta.
MERCADOPAGO_ACCESS_TOKEN="your_access_token"
MERCADOPAGO_WEBHOOK_SECRET="your_webhook_secret"
MERCADOPAGO_PUBLIC_KEY="your_public_key"
STORE_PAYMENT_PIX_EXPIRE_MINUTES=30
# Chave pública para o SDK do frontend (Checkout) — mesma PUBLIC KEY acima, com prefixo VITE_
VITE_MERCADOPAGO_PUBLIC_KEY=""
APP_BASE_URL="https://api.douradosap.com.br"

# API Full — consulta BIN/FIPE por placa (rotas GET /api/plate/decode, /api/plate/balance, POST /api/plate/payment no FastAPI)
# Documentação/workspace: https://www.postman.com/api-full/api-full/overview
# Obrigatório no servidor Python (FastAPI): sem APIFULL_TOKEN a rota /api/plate/decode retorna 503.
# Mesmo token usado pelo backend Node (plateDecodeService.ts), se ainda usar server.ts para placa.
# APIFULL_TOKEN="seu_token_apifull"
# Base da API: SOMENTE o domínio (o código monta /api/agregados-propria, get-balance, veicular/fipe, etc.).
# ERRADO: https://api.apifull.com.br/api/agregados-propria  (isso quebra todas as URLs)
# CERTO:
# APIFULL_BASE_URL="https://api.apifull.com.br"
# (Opcional: terminar em /api se a sua instalação exigir — o código tenta /api/<endpoint> e /<endpoint>.)

# Melhor Envio + Frenet (FastAPI: cotação POST /api/shipping/me/quote, /api/shipping/cotar-paralelo;
# etiquetas POST /api/shipping/me/store-orders/{id}/label e /api/shipping/me/vendas/{id}/label)
# MELHOR_ENVIO_TOKEN="..."
# Opcional: sandbox — MELHOR_ENVIO_ENV=sandbox
# CEP origem se não vier no body: MELHOR_ENVIO_FROM_POSTAL_CODE="79000000" ou configuracoes_empresa.cep
# MELHOR_ENVIO_USER_AGENT="DouradosAP CRM (suporte@douradosap.com.br)"
# Remetente (obrigatório para gerar etiqueta; senão a API ME rejeita o carrinho):
# MELHOR_ENVIO_SENDER_NAME= MELHOR_ENVIO_SENDER_EMAIL=  MELHOR_ENVIO_SENDER_PHONE=
# MELHOR_ENVIO_SENDER_COMPANY_DOCUMENT=  MELHOR_ENVIO_SENDER_DOCUMENT=
# MELHOR_ENVIO_SENDER_ADDRESS=  MELHOR_ENVIO_SENDER_COMPLEMENT=  MELHOR_ENVIO_SENDER_NUMBER=
# MELHOR_ENVIO_SENDER_DISTRICT=  MELHOR_ENVIO_SENDER_CITY=  MELHOR_ENVIO_SENDER_STATE_ABBR=
# Dimensões/peso padrão quando o produto não tem medidas (cm / kg):
# MELHOR_ENVIO_DEFAULT_HEIGHT_CM=  MELHOR_ENVIO_DEFAULT_WIDTH_CM=  MELHOR_ENVIO_DEFAULT_LENGTH_CM=  MELHOR_ENVIO_DEFAULT_WEIGHT_KG=
# Frenet (opcional no cotador paralelo): FRENET_TOKEN="..."

# --- Evolution API (WhatsApp self-hosted) — usado pelo CRM (backend/app/api/whatsapp.py)
# e pela recuperação de senha da loja online (/api/store/auth/forgot-password) ---
# EVOLUTION_API_URL="https://evo.seudominio.com.br/"
# EVOLUTION_API_KEY="chave_master_admin_da_evolution"
# EVOLUTION_WEBHOOK_SECRET="segredo_do_webhook"

# --- Resend (e-mail transacional) — fallback quando o WhatsApp não está configurado
# ou falha (ex.: código de recuperação de senha da loja, reenvio de código de cadastro) ---
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Dourados Auto Peças <noreply@seudominio.com.br>"
# EMAIL_REPLY_TO="contato@seudominio.com.br"

# --- Produto master (pecas_catalogo) — integração n8n ---
# Segredo compartilhado: header X-API-Key ou Authorization: Bearer <valor>
# Rotas: POST {VITE_API_URL}/api/integrations/pecas-master/resolve  e  .../upsert
# Resolve (cache): body JSON { "part_number": "5U0903025H" } → 200 com peca+compat ou 404 se não existir.
# Upsert (após busca externa): body JSON { "part_number", "structured"?, "raw"?, "informacoes_adicionais"? }
# Exemplo raw: { "images": ["https://..."], "results": [{ "title": "Alternador Gol..." }] }
# N8N_PECAS_MASTER_SECRET="gere_um_segredo_longo_aleatorio"

# Webhook n8n disparado pelo CRM em "Buscar part number" (POST JSON { part_number }).
# Override opcional; padrão: https://n8n.douradosap.com.br/webhook/busca_partnumber
# N8N_BUSCA_PARTNUMBER_URL="https://n8n.douradosap.com.br/webhook/busca_partnumber"
# Se o n8n gravar no Supabase em segundo plano, o backend faz polling até o registro aparecer:
# PECAS_MASTER_N8N_POLL_MAX_MS=90000
# PECAS_MASTER_N8N_POLL_INTERVAL_MS=1500

# Focus NFe (NF-e modelo 55, emissão manual via módulo Fiscal)
# Tokens por ambiente (usuário Basic Auth, senha vazia)
# FOCUS_NFE_TOKEN_PRODUCAO="seu_token_producao"
# FOCUS_NFE_TOKEN_HOMOLOGACAO="seu_token_homologacao"
#
# Opcional: parâmetros padrão de emissão
# FOCUS_NFE_SERIE="1"
# FOCUS_NFE_NATUREZA_OPERACAO="Venda de mercadoria"
# FOCUS_NFE_REGIME_TRIBUTARIO="1"
# FOCUS_NFE_CFOP_PADRAO="5405"
# FOCUS_NFE_CST_PADRAO="500"
# FOCUS_NFE_NCM_PADRAO="00000000"
# FOCUS_NFE_INFORMACOES_COMPLEMENTARES_PADRAO="garantia de 90 dias a partir da data desse pedido 26/03/2026. Trib Aprox Federal R$ ... Estadual R$ ... Fonte: IBPT/empresometro.com.br"

# --- Frete (Simulador / API): Melhor Envio + Frenet em paralelo ---
# MELHOR_ENVIO_TOKEN=
# MELHOR_ENVIO_ENV=production
# MELHOR_ENVIO_FROM_POSTAL_CODE=
# MELHOR_ENVIO_SENDER_NAME=  MELHOR_ENVIO_SENDER_EMAIL=  MELHOR_ENVIO_SENDER_PHONE=
# MELHOR_ENVIO_SENDER_COMPANY_DOCUMENT=  MELHOR_ENVIO_SENDER_DOCUMENT=
# MELHOR_ENVIO_SENDER_ADDRESS=  MELHOR_ENVIO_SENDER_COMPLEMENT=  MELHOR_ENVIO_SENDER_NUMBER=
# MELHOR_ENVIO_SENDER_DISTRICT=  MELHOR_ENVIO_SENDER_CITY=  MELHOR_ENVIO_SENDER_STATE_ABBR=
# MELHOR_ENVIO_DEFAULT_HEIGHT_CM=  MELHOR_ENVIO_DEFAULT_WIDTH_CM=  MELHOR_ENVIO_DEFAULT_LENGTH_CM=  MELHOR_ENVIO_DEFAULT_WEIGHT_KG=
# FRENET_TOKEN=  # API Frenet: header `token` em https://api.frenet.com.br/shipping/quote — ver docs.frenet.com.br


# Token que a plataforma de monitoramento usa para ler /metrics.
# Gere com: openssl rand -hex 32
METRICS_TOKEN=
