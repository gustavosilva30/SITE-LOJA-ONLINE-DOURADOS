{
    "build": {
        "env": {
            "VITE_API_URL": "https://api.douradosap.com.br"
        }
    },
    "headers": [
        {
            "source": "/:path*",
            "headers": [
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin-allow-popups"
                }
            ]
        },
        {
            "source": "/(index\\.html)?",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                },
                {
                    "key": "Pragma",
                    "value": "no-cache"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/loja",
            "destination": "https://www.autopecasdourados.com.br/",
            "permanent": true,
            "has": [{ "type": "host", "value": "autopecasdourados.com.br" }]
        },
        {
            "source": "/loja",
            "destination": "https://www.autopecasdourados.com.br/",
            "permanent": true,
            "has": [{ "type": "host", "value": "www.autopecasdourados.com.br" }]
        },
        {
            "source": "/loja/sucatas",
            "destination": "https://www.autopecasdourados.com.br/sucatas",
            "permanent": true,
            "has": [{ "type": "host", "value": "autopecasdourados.com.br" }]
        },
        {
            "source": "/loja/sucatas",
            "destination": "https://www.autopecasdourados.com.br/sucatas",
            "permanent": true,
            "has": [{ "type": "host", "value": "www.autopecasdourados.com.br" }]
        },
        {
            "source": "/loja/sucatas/:id",
            "destination": "https://www.autopecasdourados.com.br/sucatas/:id",
            "permanent": true,
            "has": [{ "type": "host", "value": "autopecasdourados.com.br" }]
        },
        {
            "source": "/loja/sucatas/:id",
            "destination": "https://www.autopecasdourados.com.br/sucatas/:id",
            "permanent": true,
            "has": [{ "type": "host", "value": "www.autopecasdourados.com.br" }]
        },
        {
            "source": "/loja/categoria/:slug",
            "destination": "https://www.autopecasdourados.com.br/categoria/:slug",
            "permanent": true,
            "has": [{ "type": "host", "value": "autopecasdourados.com.br" }]
        },
        {
            "source": "/loja/categoria/:slug",
            "destination": "https://www.autopecasdourados.com.br/categoria/:slug",
            "permanent": true,
            "has": [{ "type": "host", "value": "www.autopecasdourados.com.br" }]
        },
        {
            "source": "/(.*)",
            "destination": "https://www.autopecasdourados.com.br/$1",
            "permanent": true,
            "has": [{ "type": "host", "value": "autopecasdourados.com.br" }]
        },
        {
            "source": "/(.*)",
            "destination": "https://www.douradosap.com.br/$1",
            "permanent": true,
            "has": [{ "type": "host", "value": "douradosap.com.br" }]
        },
        {
            "source": "/loja(.*)",
            "destination": "https://www.autopecasdourados.com.br/$1",
            "permanent": true,
            "has": [{ "type": "host", "value": "douradosap.com.br" }]
        },
        {
            "source": "/loja(.*)",
            "destination": "https://www.autopecasdourados.com.br/$1",
            "permanent": true,
            "has": [{ "type": "host", "value": "www.douradosap.com.br" }]
        },
        {
            "source": "/p/:slug",
            "destination": "https://www.autopecasdourados.com.br/p/:slug",
            "permanent": true,
            "has": [{ "type": "host", "value": "douradosap.com.br" }]
        },
        {
            "source": "/p/:slug",
            "destination": "https://www.autopecasdourados.com.br/p/:slug",
            "permanent": true,
            "has": [{ "type": "host", "value": "www.douradosap.com.br" }]
        },
        {
            "source": "/checkout",
            "destination": "https://www.autopecasdourados.com.br/checkout",
            "permanent": true,
            "has": [{ "type": "host", "value": "douradosap.com.br" }]
        },
        {
            "source": "/checkout",
            "destination": "https://www.autopecasdourados.com.br/checkout",
            "permanent": true,
            "has": [{ "type": "host", "value": "www.douradosap.com.br" }]
        },
        {
            "source": "/pedido/:id",
            "destination": "https://www.autopecasdourados.com.br/pedido/:id",
            "permanent": true,
            "has": [{ "type": "host", "value": "douradosap.com.br" }]
        },
        {
            "source": "/pedido/:id",
            "destination": "https://www.autopecasdourados.com.br/pedido/:id",
            "permanent": true,
            "has": [{ "type": "host", "value": "www.douradosap.com.br" }]
        },
        {
            "source": "/meus-pedidos",
            "destination": "https://www.autopecasdourados.com.br/meus-pedidos",
            "permanent": true,
            "has": [{ "type": "host", "value": "douradosap.com.br" }]
        },
        {
            "source": "/meus-pedidos",
            "destination": "https://www.autopecasdourados.com.br/meus-pedidos",
            "permanent": true,
            "has": [{ "type": "host", "value": "www.douradosap.com.br" }]
        },
        {
            "source": "/contato",
            "destination": "https://www.autopecasdourados.com.br/contato",
            "permanent": true,
            "has": [{ "type": "host", "value": "douradosap.com.br" }]
        },
        {
            "source": "/contato",
            "destination": "https://www.autopecasdourados.com.br/contato",
            "permanent": true,
            "has": [{ "type": "host", "value": "www.douradosap.com.br" }]
        }
    ],
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "https://api.douradosap.com.br/api/sitemap.xml"
        },
        {
            "source": "/assets/:path*",
            "destination": "/assets/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}

